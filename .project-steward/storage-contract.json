        "consumer": "scripts/report_storage.py:build_report"
      }
    }
  ],
  "measurement_limits": {
    "allocated_bytes": "Conservative filesystem file-data allocation; shared extents may be counted more than once and filesystem-wide metadata is not attributed.",
    "exclusive_reclaimable_bytes": "A lower/upper bound only; never a promise of exact reclaimed space.",
    "historical_receipts": "v1 remains historical-unverified and never establishes current root ownership."
  },
  "runtime_project_roots": {
    "source": "User-selected MediaFlow projects, download deliveries and explicitly configured runtime directories are runtime project roots. Portable installs and the desktop runtime chooser retain their selected directory without requiring a development namespace. Only declared artifact subtrees, planned same-volume staging and exact outputs are registered; no drive or common user ancestor becomes an owned root.",
    "ownership_source": "mediaflow/infrastructure/storage_roots.py:project_root_ownership"
  }
}
