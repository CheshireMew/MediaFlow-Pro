{
  "protocol": "project-steward-production-storage-contract",
  "version": 3,
  "project_id": "mediaflow",
  "policy": {
    "unknown_peak": "block",
    "outside_owned_roots": "block",
    "over_budget": "block",
    "cleanup_without_authorization": "report-only"
  },
  "producers": [
    {
      "id": "local-quality-run",
      "root_source": {
        "kind": "user-environment-policy",
        "value": "quality_run_roots",
        "ownership": {
          "scope": "project-owned-external",
          "project_namespace": "mediaflow",
          "fallback": "block",
          "approved_root_source": "user-environment-policy:verification_storage_parent"
        }
      },
      "artifact_classes": [
        "temporary",
        "evidence"
      ],
      "peak_estimate": {
        "source": "quality_expected_bytes for maintenance, core or full scope",
        "unknown_behavior": "block"
      },
      "budget": {
        "maximum_managed_bytes_source": "MEDIAFLOW_QUALITY_RUN_MAX_BYTES and MEDIAFLOW_TEST_ARTIFACT_MAX_BYTES",
        "minimum_free_bytes_source": "MEDIAFLOW_MINIMUM_FREE_BYTES",
        "registered_roots_inventory_source": "mediaflow/infrastructure/storage_roots.py:registered_storage_roots",
        "filesystem_allocated_bytes_source": "mediaflow/infrastructure/storage_allocation.py:file_allocation",
        "managed_object_identity_source": "mediaflow/infrastructure/storage_inventory.py:_file_metrics"
      },
      "reuse": {
        "required": false
      },
      "lifecycle": {
        "preflight": "quality_storage_preflight runs before the evidence and work roots are created",
        "finalization": "quality-report records separate evidence and workspace inventories for passed and failed runs",
        "interruption": "A running quality-report with PID and process-start identity precedes all child commands; the reader exposes interrupted owners and retained registered roots."
      },
      "implementation_files": [
        "mediaflow/infrastructure/storage_budget.py",
        "scripts/ci/run_quality.py",
        "scripts/report_storage.py",
        "mediaflow/infrastructure/storage_allocation.py",
        "mediaflow/infrastructure/storage_inventory.py",
        "mediaflow/infrastructure/storage_roots.py",
        "mediaflow/infrastructure/storage_preflight.py",
        "mediaflow/infrastructure/storage_receipts.py"
      ],
      "test_files": [
        "tests/v2/architecture/test_ci_quality_plan.py",
        "tests/v2/infrastructure/test_storage_budget.py",
        "tests/v2/infrastructure/test_storage_capacity_contract.py"
      ],
      "enforcement": {
        "file": "scripts/ci/run_quality.py",
        "tokens": [
          "quality_run_roots",
          "quality_storage_preflight",
          "require_test_artifact_budget",
          "report-only-until-authorized"
        ]
      },
      "consumer_sources": [
        "scripts/report_storage.py:build_report"
      ],
      "manifest": {
        "source": "scripts/ci/run_quality.py:_write_report",
        "terminal_states": [
          "succeeded",
          "failed",
          "interrupted"
        ],
        "cleanup_authorization": "report-only",
        "persisted_status_mapping": {
          "passed": "succeeded",
          "failed": "failed",
          "interrupted": "interrupted"
        },
        "consumer": "scripts/report_storage.py:build_report"
      }
    },
    {
      "id": "pytest-and-verification-evidence",
      "root_source": {
        "kind": "user-environment-policy",
        "value": "test_run_root",
        "ownership": {
          "scope": "project-owned-external",
          "project_namespace": "mediaflow",
          "fallback": "block",
          "approved_root_source": "user-environment-policy:verification_storage_parent"
        }
      },
      "artifact_classes": [
        "temporary",
        "evidence"
      ],
      "peak_estimate": {
        "source": "one GiB reservation per managed pytest or verification run",
        "unknown_behavior": "block"
      },
      "budget": {
        "maximum_managed_bytes_source": "MEDIAFLOW_TEST_ARTIFACT_MAX_BYTES",
        "minimum_free_bytes_source": "MEDIAFLOW_MINIMUM_FREE_BYTES",
        "registered_roots_inventory_source": "mediaflow/infrastructure/storage_roots.py:registered_storage_roots",
        "filesystem_allocated_bytes_source": "mediaflow/infrastructure/storage_allocation.py:file_allocation",
        "managed_object_identity_source": "mediaflow/infrastructure/storage_inventory.py:_file_metrics"
      },
      "reuse": {
        "required": false
      },
      "lifecycle": {
        "preflight": "managed pytest and script runs reserve budget before creating a run directory",
        "finalization": "run-result records final payload allocation, excludes its own changing control file, and preserves passed/failed/interrupted status.",
        "interruption": "running manifests retain process ownership for later review"
      },
      "implementation_files": [
        "mediaflow/infrastructure/storage_budget.py",
        "scripts/run_artifacts.py",
        "tests/v2/conftest.py",
        "mediaflow/infrastructure/storage_allocation.py",
        "mediaflow/infrastructure/storage_inventory.py",
        "mediaflow/infrastructure/storage_roots.py",
        "mediaflow/infrastructure/storage_preflight.py",
        "mediaflow/infrastructure/storage_receipts.py"
      ],
      "test_files": [
        "tests/v2/infrastructure/test_script_run_artifacts.py",
        "tests/v2/infrastructure/test_storage_budget.py",
        "tests/v2/infrastructure/test_storage_capacity_contract.py"
      ],
      "enforcement": {
        "file": "scripts/run_artifacts.py",
        "tokens": [
          "require_test_artifact_budget",
          "run_payload_inventory",
          "storage_preflight",
          "report-only-until-authorized"
        ]
      },
      "consumer_sources": [
        "scripts/report_storage.py:build_report",
        "tests/v2/conftest.py:run_payload_inventory"
      ],
      "manifest": {
        "source": "scripts/run_artifacts.py:_manifest",
        "terminal_states": [
          "succeeded",
          "failed",
          "interrupted"
        ],
        "cleanup_authorization": "report-only",
        "persisted_status_mapping": {
          "passed": "succeeded",
          "failed": "failed",
          "interrupted": "interrupted"
        },
        "consumer": "scripts/report_storage.py:build_report"
      }
    },
    {
      "id": "project-derived-cache",
      "root_source": {
        "kind": "runtime-config",
        "value": "RuntimePaths.project_cache_dir",
        "ownership": {
          "scope": "project-owned-external",
          "project_namespace": "mediaflow",
          "fallback": "block",
          "approved_root_source": "runtime-config:runtime_storage_parent"
        }
      },
      "artifact_classes": [
        "cache",
        "temporary",
        "evidence"
      ],
      "peak_estimate": {
        "source": "BGRA pixel payload with lossless/container headroom and concurrent copies; waveform pyramid payload plus allocation-unit padding for every fragment and output.",
        "unknown_behavior": "block"
      },
      "budget": {
        "maximum_managed_bytes_source": "MEDIAFLOW_PROJECT_CACHE_MAX_BYTES and MEDIAFLOW_PROJECT_CACHES_MAX_BYTES",
        "minimum_free_bytes_source": "MEDIAFLOW_MINIMUM_FREE_BYTES",
        "registered_roots_inventory_source": "mediaflow/infrastructure/project_cache_budget.py:registered_cache_groups",
        "filesystem_allocated_bytes_source": "mediaflow/infrastructure/storage_allocation.py:file_allocation",
        "managed_object_identity_source": "mediaflow/infrastructure/storage_inventory.py:_file_metrics"
      },
      "reuse": {
        "required": true,
        "identity": "project path identity plus content-addressed render or sequence build key"
      },
      "lifecycle": {
        "preflight": "web render, segmented export and waveform generation check the project cache before the first large write",
        "finalization": "Settling the reservation measures retained allocated bytes before removing the charge; shared objects force a complete global inventory.",
        "interruption": "Unsettled or dead owners retain their charge until a complete cross-root scan covers their last writes; receipt reader exposes interrupted owners without deleting files."
      },
      "implementation_files": [
        "mediaflow/infrastructure/runtime_paths.py",
        "mediaflow/infrastructure/segmented_export_service.py",
        "mediaflow/infrastructure/storage_budget.py",
        "mediaflow/infrastructure/waveform_service.py",
        "mediaflow/infrastructure/web_render_service.py",
        "scripts/report_storage.py",
        "mediaflow/infrastructure/storage_allocation.py",
        "mediaflow/infrastructure/storage_inventory.py",
        "mediaflow/infrastructure/storage_roots.py",
        "mediaflow/infrastructure/storage_preflight.py",
        "mediaflow/infrastructure/storage_receipts.py",
        "mediaflow/infrastructure/project_cache_budget.py",
        "mediaflow/infrastructure/project_cache_reservations.py"
      ],
      "test_files": [
        "tests/v2/infrastructure/test_storage_budget.py",
        "tests/v2/infrastructure/test_media_pipeline.py",
        "tests/v2/infrastructure/test_web_media.py",
        "tests/v2/infrastructure/test_storage_capacity_contract.py"
      ],
      "enforcement": {
        "file": "mediaflow/infrastructure/project_cache_budget.py",
        "tokens": [
          "registered_cache_groups",
          "allocated_growth_bound",
          "_record_project_observation",
          "project_caches_max_bytes",
          "minimum_free_bytes",
          "start_storage_receipt"
        ]
      },
      "consumer_sources": [
        "scripts/report_storage.py:build_report"
      ],
      "manifest": {
        "source": "mediaflow/infrastructure/storage_receipts.py:finalize_storage_receipt",
        "terminal_states": [
          "succeeded",
          "failed",
          "interrupted"
        ],
        "cleanup_authorization": "report-only",
        "persisted_status_mapping": {
          "passed": "succeeded",
          "failed": "failed",
          "interrupted": "interrupted"
        },
        "consumer": "scripts/report_storage.py:build_report"
      }
    },
    {
      "id": "runtime-component-installation",
      "root_source": {
        "kind": "runtime-config",
        "value": "MEDIAFLOW_RUNTIME_DIR",
        "ownership": {
          "scope": "project-owned-external",
          "project_namespace": "mediaflow",
          "fallback": "block",
          "approved_root_source": "runtime-config:runtime_storage_parent"
        }
      },
      "artifact_classes": [
        "cache",
        "temporary",
        "evidence"
      ],
      "peak_estimate": {
        "source": "runtime-components.lock.json install.peak_install_bytes includes archive, extraction and concurrent copies",
        "unknown_behavior": "block"
      },
      "budget": {
        "maximum_managed_bytes_source": "MEDIAFLOW_RUNTIME_MAX_BYTES",
        "minimum_free_bytes_source": "MEDIAFLOW_MINIMUM_FREE_BYTES",
        "registered_roots_inventory_source": "mediaflow/infrastructure/storage_roots.py:registered_storage_roots",
        "filesystem_allocated_bytes_source": "mediaflow/infrastructure/storage_allocation.py:file_allocation",
        "managed_object_identity_source": "mediaflow/infrastructure/storage_inventory.py:_file_metrics"
      },
      "reuse": {
        "required": true,
        "identity": "component id, locked version and verified archive SHA-256"
      },
      "lifecycle": {
        "preflight": "require_runtime_budget runs before receipt, download or extraction directories are created",
        "finalization": "runtime-component storage receipt records archive and resolved installation",
        "interruption": "receipt PID and process-start identity distinguish active work from an abandoned running receipt; retained objects remain report-only"
      },
      "implementation_files": [
        "mediaflow/infrastructure/runtime_components.py",
        "mediaflow/infrastructure/storage_budget.py",
        "mediaflow/resources/runtime-components.lock.json",
        "scripts/report_storage.py",
        "mediaflow/infrastructure/storage_allocation.py",
        "mediaflow/infrastructure/storage_inventory.py",
        "mediaflow/infrastructure/storage_roots.py",
        "mediaflow/infrastructure/storage_preflight.py",
        "mediaflow/infrastructure/storage_receipts.py"
      ],
      "test_files": [
        "tests/v2/infrastructure/test_asr_cli.py",
        "tests/v2/infrastructure/test_storage_budget.py",
        "tests/v2/infrastructure/test_storage_capacity_contract.py"
      ],
      "enforcement": {
        "file": "mediaflow/infrastructure/runtime_components.py",
        "tokens": [
          "peak_install_bytes",
          "require_runtime_budget",
          "start_storage_receipt",
          "finalize_storage_receipt"
        ]
      },
      "consumer_sources": [
        "scripts/report_storage.py:build_report"
      ],
      "manifest": {
        "source": "mediaflow/infrastructure/storage_receipts.py:finalize_storage_receipt",
        "terminal_states": [
          "succeeded",
          "failed",
          "interrupted"
        ],
        "cleanup_authorization": "report-only",
        "persisted_status_mapping": {
          "passed": "succeeded",
          "failed": "failed",
          "interrupted": "interrupted"
        },
        "consumer": "scripts/report_storage.py:build_report"
      }
    },
    {
      "id": "media-download",
