# Copy this file to .env and replace every path with a location on this machine.
# Forward slashes avoid quoting problems in Python, PowerShell, and batch launchers.

# Python environment, downloaded SDKs, build output, caches, and test artifacts.
MEDIAFLOW_DEV_ROOT=D:/Tools/MediaFlow

# User projects and imported/downloaded source media. Keep these on storage sized
# for video workloads; the application will not invent a drive-letter fallback.
MEDIAFLOW_PROJECT_ROOT=E:/MediaFlow/Projects
MEDIAFLOW_MEDIA_ROOT=E:/MediaFlow/Media

# Producer repository used only when refreshing editable-media contract fixtures.
VISUAL_MULTIMEDIA_ROOT=E:/Code/visual-multimedia

# Optional overrides. Leave them commented when the standard layout under
# MEDIAFLOW_DEV_ROOT is used.
# MEDIAFLOW_RUNTIME_DIR=D:/Tools/MediaFlow/runtime
# MEDIAFLOW_SERVICE_STATE_DIR=D:/Tools/MediaFlow/service
# MEDIAFLOW_PYTHON=D:/Tools/MediaFlow/.venv/Scripts/python.exe
# MEDIAFLOW_TEST_ROOT=D:/Tools/MediaFlow/test-runs
# MEDIAFLOW_TEST_FIXTURE_ROOT=D:/Tools/MediaFlow/test-fixtures

# The values above show Windows paths. Linux and macOS use the same variable
# names with native absolute paths, for example:
# MEDIAFLOW_DEV_ROOT=/opt/mediaflow
# MEDIAFLOW_PROJECT_ROOT=/srv/mediaflow/projects
# MEDIAFLOW_MEDIA_ROOT=/srv/mediaflow/media
# MEDIAFLOW_PYTHON=/opt/mediaflow/.venv/bin/python
